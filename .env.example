# ============================================================
# god_is_typing — environment variables template
# Copy this to .env and fill in your values.
# Never commit .env (it's in .gitignore).
# ============================================================

# === LLM (default: Gemini 2.5 Flash-Lite, see ADR-0003) ===
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash-lite

# === Supabase (Postgres + pgvector + analytics) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=postgres

# === Telegram Bot API (see ADR-0013) ===
# Get this token from @BotFather on Telegram in 30 seconds.
# No business account, no verification, no Meta dashboard. Just talk to a bot.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Optional: a secret to validate webhook calls if you switch from polling to webhook
TELEGRAM_WEBHOOK_SECRET=invent_a_random_string_here

# === TTS (optional, only if voice responses enabled) ===
OPENAI_API_KEY=sk-...

# === Web search (optional) ===
TAVILY_API_KEY=tvly-...

# === Cost limits — soft circuit breaker ===
DAILY_COST_LIMIT_USD=5.00
P95_TURN_COST_LIMIT_USD=0.001

# === n8n self-hosted (deploy/n8n/docker-compose.yml) ===
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
